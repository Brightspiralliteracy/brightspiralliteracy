<!DOCTYPE html>
<!-- saved from url=(0053)file:///Users/jaoverstreet/Downloads/og-image-v2.html -->
<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { width: 1200px; height: 630px; overflow: hidden; background: #1B3A5C; }
</style>
</head>
<body>
<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">

  <rect width="1200" height="630" fill="#1B3A5C"></rect>

  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(255,255,255,0.03)" stroke-width="1"></path>
    </pattern>
    <clippath id="photoClip">
      <rect x="680" y="0" width="520" height="630"></rect>
    </clippath>
    <lineargradient id="photoFade" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1B3A5C" stop-opacity="1"></stop>
      <stop offset="30%" stop-color="#1B3A5C" stop-opacity="0"></stop>
    </lineargradient>
  </defs>

  <rect width="1200" height="630" fill="url(#grid)"></rect>

  <!-- Photo right side -->
  <image href="data:image/jpeg;base64," x="680" y="0" width="520" height="630" preserveAspectRatio="xMidYMid slice" clip-path="url(#photoClip)"></image>

  <!-- Fade overlay blending photo into navy -->
  <rect x="680" y="0" width="220" height="630" fill="url(#photoFade)"></rect>

  <!-- Dark overlay on photo for legibility -->
  <rect x="680" y="0" width="520" height="630" fill="rgba(27,58,92,0.15)"></rect>

  <!-- Orange accent bar left -->
  <rect x="0" y="0" width="8" height="630" fill="#F5A623"></rect>

  <!-- Orange bottom bar -->
  <rect x="0" y="594" width="1200" height="6" fill="#F5A623"></rect>

  <!-- Eyebrow -->
  <text x="72" y="160" font-family="Poppins, sans-serif" font-size="13" font-weight="600" fill="#F5A623" letter-spacing="3">ONLINE LITERACY TUTORING · K–5</text>

  <!-- Main headline -->
  <text x="72" y="240" font-family="Poppins, sans-serif" font-size="58" font-weight="800" fill="#ffffff" letter-spacing="-1">Your child can</text>
  <text x="72" y="310" font-family="Poppins, sans-serif" font-size="58" font-weight="800" fill="#F5A623" letter-spacing="-1">learn to read.</text>

  <!-- Subline -->
  <text x="72" y="366" font-family="Poppins, sans-serif" font-size="17" font-weight="300" fill="rgba(255,255,255,0.65)">The right instruction just hasn't found them yet.</text>

  <!-- Divider -->
  <rect x="72" y="398" width="48" height="3" fill="#F5A623" rx="2"></rect>

  <!-- Method pills -->
  <rect x="72" y="418" width="70" height="26" rx="13" fill="#1B3A5C" stroke="rgba(255,255,255,0.2)" stroke-width="1"></rect>
  <text x="107" y="435" font-family="Poppins, sans-serif" font-size="11" font-weight="600" fill="rgba(255,255,255,0.7)" text-anchor="middle">Ground</text>

  <rect x="152" y="418" width="60" height="26" rx="13" fill="rgba(245,166,35,0.15)" stroke="rgba(245,166,35,0.4)" stroke-width="1"></rect>
  <text x="182" y="435" font-family="Poppins, sans-serif" font-size="11" font-weight="600" fill="#F5A623" text-anchor="middle">Build</text>

  <rect x="222" y="418" width="54" height="26" rx="13" fill="rgba(42,138,138,0.15)" stroke="rgba(42,138,138,0.4)" stroke-width="1"></rect>
  <text x="249" y="435" font-family="Poppins, sans-serif" font-size="11" font-weight="600" fill="#2A8A8A" text-anchor="middle">Rise</text>

  <rect x="286" y="418" width="60" height="26" rx="13" fill="rgba(192,57,43,0.15)" stroke="rgba(192,57,43,0.4)" stroke-width="1"></rect>
  <text x="316" y="435" font-family="Poppins, sans-serif" font-size="11" font-weight="600" fill="#C0392B" text-anchor="middle">Shine</text>

  <!-- Name -->
  <text x="72" y="506" font-family="Poppins, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Dr. Jenn Overstreet</text>
  <text x="72" y="534" font-family="Poppins, sans-serif" font-size="15" font-weight="300" fill="rgba(255,255,255,0.5)">Reading Specialist · International School Families</text>
  <text x="72" y="572" font-family="Poppins, sans-serif" font-size="13" font-weight="400" fill="rgba(245,166,35,0.8)">brightspiralliteracy.com</text>

</svg>

</body></html>
